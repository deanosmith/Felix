{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Felix",
            "type": "process",
            "command": "zsh",
            "args": ["${workspaceFolder}/scripts/build-app.sh"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Run Felix",
            "type": "process",
            "command": "open",
            "args": ["${workspaceFolder}/dist/Felix.app"],
            "problemMatcher": []
        },
        {
            "label": "Test Text Replacements",
            "type": "process",
            "command": "zsh",
            "args": ["${workspaceFolder}/scripts/test-text-replacements.sh"],
            "problemMatcher": []
        }
    ]
}